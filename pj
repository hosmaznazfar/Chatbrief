#!/usr/bin/env python3
"""Chatbrief's project-local workflow helper (Python standard library only)."""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

CONFIG = Path(".pj/workflow.toml")
MINIMUM_PYTHON = (3, 14)


def project_root() -> Path:
    return Path(__file__).resolve().parent


def load_config(root: Path) -> dict:
    path = root / CONFIG
    try:
        with path.open("rb") as stream:
            config = tomllib.load(stream)
    except FileNotFoundError as exc:
        raise ValueError(f"Missing {CONFIG}; run ./pj init first.") from exc
    except tomllib.TOMLDecodeError as exc:
        raise ValueError(f"Invalid TOML in {CONFIG}: {exc}") from exc
    validate(config, root)
    return config


def validate(config: dict, root: Path) -> None:
    if not isinstance(config, dict):
        raise ValueError("Workflow configuration must be a TOML table.")

    schema_version = config.get("schema_version")
    if type(schema_version) is not int or schema_version != 1:
        raise ValueError("Unsupported workflow schema_version; expected integer 1.")

    project = config.get("project", {})
    if not isinstance(project, dict):
        raise ValueError("project must be a table.")
    project_name = project.get("name")
    if project_name is not None and (
        not isinstance(project_name, str) or not project_name.strip()
    ):
        raise ValueError("project.name must be a non-empty string.")

    checks = config.get("checks")
    if not isinstance(checks, dict):
        raise ValueError("checks must be a table.")
    fail_fast = checks.get("fail_fast", True)
    if not isinstance(fail_fast, bool):
        raise ValueError("checks.fail_fast must be a boolean.")

    steps = checks.get("steps", [])
    if not isinstance(steps, list):
        raise ValueError("checks.steps must be an array of tables.")

    project_directory = root.resolve()
    names: set[str] = set()

    for index, step in enumerate(steps, 1):
        if not isinstance(step, dict):
            raise ValueError(f"Check {index} must be a table.")

        name = step.get("name")
        command = step.get("command")
        if not isinstance(name, str) or not name.strip():
            raise ValueError(f"Check {index} needs a non-empty name.")
        name = name.strip()
        if name in names:
            raise ValueError(f"Duplicate check name: {name}")
        names.add(name)

        if not isinstance(command, str) or not command.strip():
            raise ValueError(f"Check '{name}' needs a non-empty command.")

        args = step.get("args", [])
        if not isinstance(args, list) or not all(isinstance(arg, str) for arg in args):
            raise ValueError(f"Check '{name}' args must be an array of strings.")

        cwd = step.get("cwd", ".")
        if not isinstance(cwd, str) or not cwd.strip():
            raise ValueError(f"Check '{name}' cwd must be a non-empty relative path.")
        cwd_path = Path(cwd)
        if cwd_path.is_absolute():
            raise ValueError(f"Check '{name}' cwd must stay inside the project.")
        try:
            resolved_cwd = (project_directory / cwd_path).resolve()
            resolved_cwd.relative_to(project_directory)
        except (OSError, ValueError) as exc:
            raise ValueError(
                f"Check '{name}' cwd must resolve inside the project: {cwd}"
            ) from exc
        if not resolved_cwd.is_dir():
            raise ValueError(f"Check '{name}' cwd does not exist or is not a directory: {cwd}")

        timeout = step.get("timeout_seconds")
        if timeout is not None and (type(timeout) is not int or timeout <= 0):
            raise ValueError(f"Check '{name}' timeout_seconds must be a positive integer.")

        requires = step.get("requires", [])
        if not isinstance(requires, list) or not all(
            isinstance(item, str) and item.strip() for item in requires
        ):
            raise ValueError(
                f"Check '{name}' requires must be an array of non-empty executable names."
            )

        required = step.get("required", True)
        if not isinstance(required, bool):
            raise ValueError(f"Check '{name}' required must be a boolean.")

        description = step.get("description")
        if description is not None and not isinstance(description, str):
            raise ValueError(f"Check '{name}' description must be a string.")


def doctor(root: Path) -> int:
    print(f"[pj doctor] {root}")
    healthy = True

    python_version = sys.version_info[:2]
    python_text = ".".join(map(str, sys.version_info[:3]))
    if python_version >= MINIMUM_PYTHON:
        print(f" Python    {python_text} (supported; requires >=3.14)")
    else:
        print(f" Python    {python_text} (unsupported; requires >=3.14)")
        healthy = False

    uv = shutil.which("uv")
    if uv:
        print(f" uv        available: {uv}")
    else:
        print(" uv        not found (required)")
        print(
            " guidance  install uv: "
            "https://docs.astral.sh/uv/getting-started/installation/"
        )
        healthy = False

    graphify = shutil.which("graphify")
    if graphify:
        print(f" Graphify   available (optional): {graphify}")
    else:
        print(" Graphify   not installed (optional; run ./pj graph install)")

    config_path = root / CONFIG
    if not config_path.is_file():
        print(f" config    not initialized ({CONFIG}; run ./pj init)")
        healthy = False
    else:
        try:
            config = load_config(root)
        except (OSError, ValueError) as exc:
            print(f" config    invalid: {exc}")
            healthy = False
        else:
            count = len(config["checks"].get("steps", []))
            print(f" config    valid ({count} checks)")
            if not count:
                print(" guidance  no checks configured; edit .pj/workflow.toml")

    return 0 if healthy else 1


def init(root: Path) -> None:
    path = root / CONFIG
    if path.exists():
        config = load_config(root)
        count = len(config["checks"].get("steps", []))
        print(f"[pj init] Existing config valid; preserving it ({count} checks).")
        return

    if not (root / "pyproject.toml").is_file():
        raise ValueError("This helper is configured for Python projects with pyproject.toml.")

    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "# Chatbrief project-local checks. Commands run without a shell.\n"
        "schema_version = 1\n\n"
        "[project]\nname = \"Chatbrief\"\n\n"
        "[checks]\nfail_fast = true\n",
        encoding="utf-8",
    )
    print(f"[pj init] Created {CONFIG}. Add project checks before running ./pj check.")


def list_checks(config: dict) -> None:
    steps = config["checks"].get("steps", [])
    if not steps:
        print("No checks configured.")
        return
    for index, step in enumerate(steps, 1):
        command = " ".join([step["command"], *step.get("args", [])])
        print(f"{index}. {step['name']}: {command}")


def run_checks(root: Path, config: dict, *, dry_run: bool) -> int:
    checks = config["checks"]
    steps = checks.get("steps", [])
    if not steps:
        print("No checks configured.")
        return 0

    required_failure = False
    for step in steps:
        name = step["name"]
        command = step["command"]
        args = step.get("args", [])
        cwd = (root / step.get("cwd", ".")).resolve()
        display = " ".join([command, *args])

        if dry_run:
            print(f"[dry-run] ({cwd}) {display}")
            continue

        missing = [
            item for item in step.get("requires", []) if shutil.which(item) is None
        ]
        if missing:
            print(f"SKIP {name}: missing {', '.join(missing)}")
            step_failed = True
        elif shutil.which(command) is None:
            print(f"FAIL {name}: executable '{command}' not found")
            step_failed = True
        else:
            print(f"\n[pj check] {name}: {display}", flush=True)
            try:
                result = subprocess.run(
                    [command, *args],
                    cwd=cwd,
                    check=False,
                    timeout=step.get("timeout_seconds"),
                )
            except subprocess.TimeoutExpired:
                limit = step.get("timeout_seconds", "not set")
                print(f"FAIL {name}: timed out (limit: {limit} seconds)")
                step_failed = True
            except OSError as exc:
                print(f"FAIL {name}: could not start command: {exc}")
                step_failed = True
            else:
                step_failed = result.returncode != 0
                print(f"{'FAIL' if step_failed else 'PASS'} {name}")
                if step_failed:
                    print(f"       exit status: {result.returncode}")

        if step_failed and step.get("required", True):
            required_failure = True
        if step_failed and checks.get("fail_fast", True):
            break

    return 1 if required_failure else 0



def run_graphify(root: Path, arguments: list[str], *, local_only: bool = False) -> int:
    executable = shutil.which("graphify")
    if executable is None:
        print(
            "[pj graph] Graphify is not installed. Run './pj graph install' "
            "or 'uv tool install graphifyy'.",
            file=sys.stderr,
        )
        return 1

    environment = None
    if local_only:
        environment = os.environ.copy()
        environment["GRAPHIFY_BACKEND"] = "none"

    display = " ".join(["graphify", *arguments])
    print(f"[pj graph] {display}", flush=True)
    try:
        result = subprocess.run(
            [executable, *arguments],
            cwd=root,
            env=environment,
            check=False,
        )
    except OSError as exc:
        print(f"[pj graph] could not start Graphify: {exc}", file=sys.stderr)
        return 1
    return result.returncode


def graph_status(root: Path) -> int:
    print(f"[pj graph status] {root}")
    executable = shutil.which("graphify")
    if executable is None:
        print(" Graphify  not installed (optional; run ./pj graph install)")
    else:
        try:
            version = subprocess.run(
                [executable, "--version"],
                cwd=root,
                capture_output=True,
                text=True,
                check=False,
                timeout=10,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            print(f" Graphify  available but version check failed: {exc}")
        else:
            detail = (version.stdout or version.stderr).strip()
            print(f" Graphify  {detail or 'available'}")

    output = root / "graphify-out"
    artifacts = ("graph.json", "GRAPH_REPORT.md", "graph.html")
    present = 0
    for name in artifacts:
        path = output / name
        if path.is_file():
            print(f" {name:<16} present")
            present += 1
        else:
            print(f" {name:<16} missing")
    if present == len(artifacts):
        print(" Graph       all primary artifacts exist")
    elif present:
        print(" Graph       incomplete; run ./pj graph refresh")
    else:
        print(" Graph       not generated; run ./pj graph refresh")

    git = shutil.which("git")
    if git:
        result = subprocess.run(
            [git, "status", "--short", "--", "graphify-out"],
            cwd=root,
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            state = result.stdout.strip()
            print(f" Git graph  {state if state else 'no graphify-out changes'}")
        else:
            print(" Git graph  could not inspect status")

    if executable:
        print(" Git hooks  ", end="")
        result = subprocess.run(
            [executable, "hook", "status"],
            cwd=root,
            check=False,
        )
        if result.returncode:
            print("status command failed")
    return 0



def graph_diff(root: Path) -> int:
    git = shutil.which("git")
    if git is None:
        print("[pj graph diff] git is not installed.", file=sys.stderr)
        return 1

    print("[pj graph diff] Graphify artifact status")
    status = subprocess.run(
        [git, "status", "--short", "--", "graphify-out"],
        cwd=root,
        check=False,
    )
    if status.returncode:
        return status.returncode

    print("\\n[pj graph diff] Tracked graph changes against HEAD")
    diff = subprocess.run(
        [git, "diff", "HEAD", "--", "graphify-out"],
        cwd=root,
        check=False,
    )
    if diff.returncode:
        return diff.returncode

    print(
        "\\nReview untracked graph files shown by git status separately. "
        "After staging only approved artifacts, run "
        "'git diff --cached -- graphify-out' before committing."
    )
    return 0


def graph_command(root: Path, args: argparse.Namespace) -> int:
    action = args.graph_command

    if action == "install":
        uv = shutil.which("uv")
        if uv is None:
            print("[pj graph] uv is required to install Graphify: https://docs.astral.sh/uv/", file=sys.stderr)
            return 1
        if shutil.which("graphify"):
            print("[pj graph] Graphify is already available; no installation needed.")
            return 0
        print("[pj graph] Installing the standalone Graphify CLI (no AI-editor integration).")
        result = subprocess.run([uv, "tool", "install", "graphifyy"], cwd=root, check=False)
        return result.returncode

    if action == "status":
        return graph_status(root)

    if action == "build":
        command = ["extract", ".", *( [] if args.semantic else ["--code-only"] )]
        return run_graphify(root, command, local_only=not args.semantic)

    if action == "update":
        return run_graphify(root, ["update", "."], local_only=not args.semantic)

    if action == "sync":
        graph_file = root / "graphify-out" / "graph.json"
        if graph_file.is_file():
            return run_graphify(root, ["update", "."], local_only=not args.semantic)
        command = ["extract", ".", *( [] if args.semantic else ["--code-only"] )]
        return run_graphify(root, command, local_only=not args.semantic)

    if action == "refresh":
        graph_file = root / "graphify-out" / "graph.json"
        if graph_file.is_file():
            result = run_graphify(root, ["update", "."], local_only=not args.semantic)
        else:
            command = ["extract", ".", *( [] if args.semantic else ["--code-only"] )]
            result = run_graphify(root, command, local_only=not args.semantic)
        if result:
            return result
        result = run_graphify(root, ["cluster-only", "."], local_only=not args.semantic)
        if result:
            return result
        return graph_status(root)

    if action == "diff":
        return graph_diff(root)

    if action == "query":
        return run_graphify(root, ["query", " ".join(args.question)])

    if action == "path":
        return run_graphify(root, ["path", args.source, args.target])

    if action == "explain":
        return run_graphify(root, ["explain", " ".join(args.concept)])

    if action == "watch":
        return run_graphify(root, ["watch", "."])

    if action == "hooks":
        return run_graphify(root, ["hook", args.hook_action])

    return 1

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pj",
        description="Chatbrief workflow: Python checks and local Graphify automation (standard library + uv).",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("init", help="Create or validate the project workflow config")
    commands.add_parser("doctor", help="Check Chatbrief's Python and uv prerequisites")
    check = commands.add_parser("check", help="List or run configured checks in order")
    check.add_argument("--list", action="store_true", help="List configured checks")
    check.add_argument("--dry-run", action="store_true", help="Print commands without running them")
    graph = commands.add_parser("graph", help="Build, query, and automate the shared Graphify code graph")
    graph_commands = graph.add_subparsers(dest="graph_command", required=True)
    graph_commands.add_parser("install", help="Install the standalone Graphify CLI with uv")
    graph_commands.add_parser("status", help="Inspect graph artifacts, Git changes, and Graphify hooks")
    build = graph_commands.add_parser("build", help="Build the local code graph (no API/backend by default)")
    build.add_argument("--semantic", action="store_true", help="Include semantic extraction using the configured Graphify backend")
    update = graph_commands.add_parser("update", help="Incrementally update the graph after local changes or a pull")
    update.add_argument("--semantic", action="store_true", help="Allow the configured Graphify backend for changed documents")
    sync = graph_commands.add_parser("sync", help="Build if missing, otherwise update the graph")
    sync.add_argument("--semantic", action="store_true", help="Allow the configured Graphify backend for changed documents")
    refresh = graph_commands.add_parser("refresh", help="Update/build the graph, generate report and HTML, then show status")
    refresh.add_argument("--semantic", action="store_true", help="Allow the configured Graphify backend for changed documents")
    graph_commands.add_parser("diff", help="Show graphify-out Git status and tracked changes against HEAD")
    query = graph_commands.add_parser("query", help="Query the graph with a natural-language question")
    query.add_argument("question", nargs="+")
    path = graph_commands.add_parser("path", help="Find the graph path between two symbols")
    path.add_argument("source")
    path.add_argument("target")
    explain = graph_commands.add_parser("explain", help="Explain a symbol and its graph connections")
    explain.add_argument("concept", nargs="+")
    graph_commands.add_parser("watch", help="Watch files and refresh the graph (requires Graphify's watch extra)")
    hooks = graph_commands.add_parser("hooks", help="Manage Graphify's local Git hooks and graph merge driver")
    hooks.add_argument("hook_action", choices=("install", "status", "uninstall"))
    workflow = commands.add_parser("workflow", help="Workflow configuration operations")
    workflow.add_subparsers(dest="workflow_command", required=True).add_parser(
        "validate", help="Validate .pj/workflow.toml"
    )
    return parser


def main() -> int:
    args = build_parser().parse_args()
    root = project_root()
    try:
        if args.command == "init":
            init(root)
            return 0
        if args.command == "doctor":
            return doctor(root)
        if args.command == "graph":
            return graph_command(root, args)
        if args.command == "workflow":
            config = load_config(root)
            count = len(config["checks"].get("steps", []))
            print(f"Workflow configuration valid ({count} checks).")
            return 0
        if args.command == "check":
            config = load_config(root)
            if args.list:
                list_checks(config)
                return 0
            return run_checks(root, config, dry_run=args.dry_run)
    except (OSError, ValueError) as exc:
        print(f"[pj] error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
